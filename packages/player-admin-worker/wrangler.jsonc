{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kotobad-player-admin-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-30",
	"build": {
		"command": "bun run build:admin-ui"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "admin-ui/dist"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "b3s-db",
			"database_id": "327f87b2-38c3-4232-a89d-6cb0c635e97e"
		}
	],
	"r2_buckets": [
		{
			"binding": "KOTOBAD_BUCKET",
			"bucket_name": "kotobad-bucket",
			"remote": true
		}
	],
	"env": {
		"production": {
			"vars": {
				"APP_ENV": "production"
			}
		}
	}
}
