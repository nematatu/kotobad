{
	"name": "@kotobad/player-admin-worker",
	"type": "module",
	"scripts": {
		"dev": "bun run build:admin-ui && wrangler dev --ip 0.0.0.0 --port 8788 --inspector-port 9230 --persist-to ../backend/.wrangler/state",
		"build:admin-ui": "vite build --config admin-ui/vite.config.ts --base ./",
		"deploy": "bun run build:admin-ui && wrangler deploy --minify --env production",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.15",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.10",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"vite": "^8.0.3",
		"wrangler": "4.80.0"
	}
}
