{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kotobad-backend",
	"main": "src/index.ts",
	"compatibility_date": "2025-08-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "b3s-db",
			"database_id": "327f87b2-38c3-4232-a89d-6cb0c635e97e",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"env": {
		"production": {
			"vars": {
				"APP_ENV": "production"
			}
		}
	},
  "r2_buckets": [
      {
          "binding": "KOTOBAD_BUCKET", 
          "bucket_name": "kotobad-bucket",
          "remote": true
      }
  ], 
  "durable_objects": {
      "bindings": [
        {
            "name": "THREAD_ROOM", 
            "class_name": "ThreadRoom"
        }
      ]
  }, 
  "migrations": [
      {
          "tag": "v1-thread-room", 
          "new_sqlite_classes": ["ThreadRoom"]
      }
  ],
	"triggers": {
		"crons": ["0 */12 * * *"]
	}
}
