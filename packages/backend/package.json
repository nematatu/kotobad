{
	"name": "@kotobad/backend",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --ip 0.0.0.0 --port 8787",
		"dev:local": "wrangler dev --ip 0.0.0.0 --port 8787",
		"dev:remote": "wrangler dev --remote --ip 0.0.0.0 --port 8787",
		"dev:prod": "wrangler dev --ip 0.0.0.0 --port 8787 -e dev-prod",
		"deploy": "OPEN_NEXT_DEPLOY=true wrangler deploy --minify",
		"deploy:preview": "wrangler versions upload",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"generate": "drizzle-kit generate",
		"local:migration": "bun x wrangler d1 migrations apply b3s-db --local",
		"remote:migration": "wrangler d1 migrations apply b3s-db --remote",
		"local:tables": "wrangler d1 execute b3s-db --local --command \"SELECT sql FROM sqlite_master WHERE type='table';\"",
		"remote:tables": "wrangler d1 execute b3s-db --remote --command \"SELECT sql FROM sqlite_master WHERE type='table';\"",
		"studio": "bunx drizzle-kit studio"
	},
	"dependencies": {
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.3.0",
		"@kotobad/shared": "workspace:*",
		"better-auth": "^1.6.9",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.15",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"@cloudflare/workers-types": "^4.20260426.1",
		"drizzle-kit": "0.31.10",
		"wrangler": "^4.86.0"
	}
}
