{
	"name": "@kotobad/frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"generate:product-update-markdown": "bun ./scripts/generate-product-update-markdown.ts",
		"dev": "bun run generate:product-update-markdown && next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"cf:build": "opennextjs-cloudflare build",
		"deploy": "opennextjs-cloudflare deploy",
		"deploy:preview": "opennextjs-cloudflare deploy --env preview",
		"preview": "bun run cf:build && bun opennextjs-cloudflare preview --port 3000",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"build:check-and-save-assets": "bun run cf:build && bun ../../scripts/check-save-next-static-assets.ts"
	},
	"dependencies": {
		"@kotobad/shared": "workspace:*",
		"@lottiefiles/react-lottie-player": "^3.6.0",
		"@opennextjs/cloudflare": "^1.19.4",
		"@opentelemetry/api": "^1.9.1",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tabler/icons-react": "^3.41.1",
		"@tailwindcss/line-clamp": "^0.4.4",
		"better-auth": "^1.6.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"emoji-picker-react": "^4.19.1",
		"framer-motion": "^12.38.0",
		"lucide-react": "^1.14.0",
		"motion": "^12.38.0",
		"next": "16.2.4",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.74.0",
		"react-icons": "^5.6.0",
		"react-markdown": "^10.1.0",
		"react-use-measure": "^2.1.7",
		"remark-gfm": "^4.0.1",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"swr": "^2.4.1",
		"tailwind-merge": "^3.5.0",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@svgr/webpack": "8.1.0",
		"@tailwindcss/postcss": "^4.2.4",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"lru-cache": "11.3.5",
		"postcss": "^8.5.12",
		"postcss-load-config": "^6.0.1",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"webpack": "^5.106.2",
		"wrangler": "^4.86.0"
	}
}
