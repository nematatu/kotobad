{
	"name": "kotobad",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@types/bun": "^1.3.11",
		"docsify-cli": "^4.4.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"scaffdog": "^4.1.0",
		"wrangler": "^4.80.0"
	},
	"peerDependencies": {
		"typescript": "^6.0.2"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun --filter '@kotobad/backend' dev & bun --filter '@kotobad/frontend' dev & bun run dev:player-admin-worker & bun --filter '@kotobad/backend' studio",
		"dev:frontend": "bun --filter '@kotobad/frontend' dev",
		"dev:backend": "bun --filter '@kotobad/backend' dev",
		"dev:player-admin-worker": "cd packages/player-admin-worker && bun run dev",
		"build:frontend": "bun --filter '@kotobad/frontend' build",
		"build:backend": "bun --filter '@kotobad/backend' build",
		"deploy:frontend": "bun --filter '@kotobad/frontend' deploy",
		"deploy:backend": "bun --filter '@kotobad/backend' deploy",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write",
		"prepare": "husky",
		"docs": "scaffdog generate",
		"docs:serve": "bun scripts/docsify-generate-sidebar.ts && docsify serve ./docs",
		"studio": "bun --filter '@kotobad/backend' studio"
	},
	"lint-staged": {
		"packages/**/src/**/*.{ts,tsx}": [
			"bunx biome format --write",
			"bunx biome check --write"
		]
	},
	"dependencies": {
		"@biomejs/biome": "^2.4.10"
	}
}
