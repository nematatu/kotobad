{
	"name": "kotobad",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0"
	},
	"peerDependencies": {
		"typescript": "^6.0.2"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun --filter '@kotobad/backend' dev & bun --filter '@kotobad/frontend' dev & bun --filter '@kotobad/backend' studio",
		"dev:frontend": "bun --filter '@kotobad/frontend' dev",
		"dev:backend": "bun --filter '@kotobad/backend' dev",
		"build:frontend": "bun --filter '@kotobad/frontend' build",
		"build:backend": "bun --filter '@kotobad/backend' build",
		"build:frontend:cf": "bun --filter '@kotobad/frontend' build:check-and-save-assets",
		"deploy:frontend": "bun --filter '@kotobad/frontend' deploy",
		"deploy:frontend:preview": "bun --filter '@kotobad/frontend' deploy:preview",
		"deploy:backend": "bun --filter '@kotobad/backend' deploy",
		"deploy:backend:preview": "bun --filter '@kotobad/backend' deploy:preview",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write",
		"prepare": "husky",
		"docs": "bunx scaffdog generate",
		"docs:serve": "bun scripts/docsify-generate-sidebar.ts && bunx docsify-cli serve ./docs",
		"studio": "bun --filter '@kotobad/backend' studio"
	},
	"lint-staged": {
		"packages/**/src/**/*.{ts,tsx}": [
			"bunx biome format --write",
			"bunx biome check --write"
		]
	},
	"dependencies": {
		"@biomejs/biome": "^2.4.13"
	}
}
